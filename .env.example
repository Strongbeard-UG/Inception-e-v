# Vorlage. Kopieren nach .env und ausfüllen. Die echte .env kommt NIE ins Repo (Repo ist öffentlich).

# Google Maps (Browser-Key, in der Google Cloud auf https://trees.inception.green/* beschränken)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Map-ID aus Google Cloud > Map Management (für eigene Marker-Icons nötig)
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Supabase
SUPABASE_URL=
# Nur Lesen, für die Webseite
SUPABASE_ANON_KEY=
# Schreiben, NUR für den nächtlichen Sync auf dem Server
SUPABASE_SERVICE_ROLE_KEY=

# Notion (Integration mit Lesezugriff auf das Tracking, Schreibzugriff für Koordinaten)
NOTION_TOKEN=
NOTION_SCHOOLS_DATA_SOURCE=2a821dae-4be5-81ea-8796-000bc28742e5
NOTION_COMMUNITIES_DATA_SOURCE=2a821dae-4be5-816c-a8c3-000bb85441c3
# true = gefundene Koordinaten in Notion zurückschreiben
NOTION_WRITE_COORDINATES=false

# Greenstand / Treetracker
GREENSTAND_ORGANIZATION_ID=1335
# Filter der Kartenschnittstelle (organization_id wird dort ignoriert)
GREENSTAND_MAP_NAME=inception
# Suchgebiet (West,Süd,Ost,Nord), Standard: Ost-Uganda
GREENSTAND_BOUNDS=32.5,-0.6,35.1,2.0
